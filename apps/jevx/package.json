{
  "name": "jevx",
  "version": "0.4.0",
  "description": "Find where Jev (TypeSafe Noul / Choice / Score) fits in your TypeScript / JavaScript codebase, and change it — from the terminal or from Claude Code / Cursor.",
  "keywords": [
    "jev",
    "typesafe",
    "ai",
    "refactor",
    "cli",
    "mcp",
    "claude-code",
    "cursor",
    "typescript",
    "code-analysis"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "jevx": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "c12": "^3.3.4",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "diff": "^8.0.2",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.0",
    "ts-morph": "^28.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@jevx/analyzer": "workspace:*",
    "@jevx/core": "workspace:*",
    "@jevx/engine": "workspace:*",
    "@jevx/gemini": "workspace:*",
    "@jevx/scanner": "workspace:*",
    "@jevx/typesafe": "workspace:*"
  }
}
