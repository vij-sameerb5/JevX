{
  "manifest_version": 3,
  "name": "JevX for GitHub",
  "version": "0.3.0",
  "description": "Open a GitHub repo and see where Jev (TypeSafe noul / choice / score) fits in it, with JevX confidence cards. Uses your own Gemini, xAI or OpenRouter key. Read-only.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "JevX: where does Jev fit in this repo?", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "permissions": ["sidePanel", "storage", "tabs"],
  "host_permissions": [
    "https://api.github.com/*",
    "https://raw.githubusercontent.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.x.ai/*",
    "https://openrouter.ai/*",
    "https://api.typesafe.ai/*"
  ]
}
