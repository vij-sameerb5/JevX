# JevX keys. Copy to .env and fill in. .env is git-ignored; .env.example is not — keep it empty.
# jevx reads this file when JEVX_ENV_FILE points to it. Values already set in your shell win.

# AI that reads your code (one of these)
XAI_API_KEY=
OPENROUTER_API_KEY=

# Optional: Jev's own opinion on every scorecard
TYPESAFE_API_KEY=

# Optional: share anonymous outcomes to the JevX dataset (no code is sent)
JEVX_SHARE=0
JEVX_SUPABASE_URL=
JEVX_SUPABASE_ANON_KEY=
